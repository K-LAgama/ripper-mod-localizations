    "simple-quest": {
        "tutorialTips": {
            "tipsExplaination": {
                "title": "教程提示",
                "text": "这是一条教程提示。您可以在模块设置中关闭提示。点击“关闭”按钮可隐藏提示，直至下次刷新；或点击骰子按钮阅读另一条提示。"
            },
            "quickVisibility": {
                "title": "快速查看",
                "text": "使用 <kbd>Alt + 左键点击</kbd> 可快速隐藏或显示玩家的“简单任务”元素。在侧边栏中，<kbd>Alt + 左键点击</kbd> 某页面可切换其“观察者”权限。 您还可以<kbd>按住 Alt 键并左键单击</kbd>任务目标的复选框来切换其隐藏状态，并对 Simple Quest 地图页面上的标记执行同样的操作。"
            },
            "quickModal": {
                "title": "以模态窗口形式打开",
                "text": "在“简单任务”页面上，对内容链接使用 <kbd>Alt + 左键单击</kbd> 可打开一个模态窗口。这将以模态窗口的形式打开该页面，让您无需切换当前页面即可查看该页面的内容。 您可以在任意位置 <kbd>双击左键</kbd>，或点击右上角的“X”按钮来关闭模态窗口。"
            },
            "questRecap": {
                "title": "任务回顾",
                "text": "在“任务”标签页侧边栏中切换“摘要”按钮，即可按任务状态（进行中、已完成、失败和未发现）对任务进行分组，而无需浏览文件夹树。每个组均可展开或折叠，且系统会记住折叠状态，以便您下次访问时使用。"
            },
            "tabContextMenu": {
                "title": "标签自定义",
                "text": "<kbd>右键单击</kbd>任意标签页标题，即可打开“文件夹”上下文菜单。您还可以在“Simple Quest”根目录内创建新的子文件夹。新文件夹将作为新的动态标签页显示。"
            },
            "staticTabs": {
                "title": "特殊目录",
                "text": "侧边栏顶部的四个图标标签页（“我的日记”、“派对日记”、“时间线”和“成就”）是特殊的静态标签页，与初始设置时创建的专用文件夹相关联。 <kbd>右键单击</kbd>任何静态标签页，即可编辑其对应的文件夹。如果标签页对应的文件夹尚未创建，该标签页将显示为灰色。您可以在文件夹配置窗口中将某个文件夹指定为特殊目录。"
            },
            "sectionOrder": {
                "title": "章节排序",
                "text": "编辑日志页面时，每个结构化部分（如图标列表、属性栏或表格）都设有“顺序”字段。设置一个数字即可控制该部分在页面上的显示位置。数字越小的部分显示在前面。"
            },
            "insertPage": {
                "title": "更多文本样式",
                "text": "您可以使用 ProseMirror 工具栏中的“注释”和“插入页面”下拉菜单，添加主题文本样式，例如用于背景设定、生物或 NPC 的彩色注释，以及装饰性的羊皮纸笔记或卷轴。"
            },
            "sectionHidden": {
                "title": "隐藏章节",
                "text": "日志页面上的每个结构化部分都有一个“隐藏”复选框。勾选后，该部分将对非所有者玩家隐藏。作为页面所有者，您仍然可以看到该部分，但其周围会显示虚线边框，以表明该部分对您的玩家是隐藏的。"
            },
            "pageVisibility": {
                "title": "页面可见性",
                "text": "侧边栏中日志条目和页面右侧显示的彩色圆点，表示哪些玩家可以看到该文档。如果某页面没有圆点，则任何玩家都无法看到该页面。 每个圆点代表一位权限与默认设置不同的用户。当默认权限高于“无”时，会显示“所有玩家”的圆点。这些指示符仅对游戏管理员可见，并可通过“显示日志所有权”设置进行切换。"
            }
        },
